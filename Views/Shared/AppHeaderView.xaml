<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_project.Views.Shared.AppHeaderView">
    <Grid ColumnDefinitions="*,*,*" Padding="10" BackgroundColor="#635BFF">
        <Button Text="Create user" TextColor="White" BackgroundColor="Transparent" Clicked="OnCreateUserClicked"/>
        <Button Grid.Column="1" Text="Users" TextColor="White" BackgroundColor="Transparent" Clicked="OnUsersClicked"/>
        <Button Grid.Column="2" Text="Home" TextColor="White" BackgroundColor="Transparent" Clicked="OnHomeClicked"/>
    </Grid>
</ContentView>
