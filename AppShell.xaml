    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:maui_project.Views.Users"
    x:Class="maui_project.AppShell"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Create user"
        ContentTemplate="{DataTemplate views:CreateUserPage}"
        Route="CreateUserPage" />
    
    <ShellContent
        Title="Users"
        ContentTemplate="{DataTemplate views:UsersPage}"
        Route="UsersPage"/>

</Shell>
